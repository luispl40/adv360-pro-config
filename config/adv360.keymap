#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        rgb_ug_L0: rgb_ug_L0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_COLOR_HSB(97,100,25) &to 0>;
            label = "RGB_UG_L0";
        };

        rgb_ug_L1: rgb_ug_L1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_COLOR_HSB(241,34,57) &to 1>;
            label = "RGB_UG_L1";
        };

        rgb_ug_L2: rgb_ug_L2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_COLOR_HSB(36,88,43) &to 2>;
            label = "RGB_UG_L2";
        };

        rgb_ug_L3: rgb_ug_L3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_COLOR_HSB(0,88,43) &to 3>;
            label = "RGB_UG_L3";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &tog 1                                                             &bootloader  &kp N6  &kp N7  &kp N8     &kp N9    &kp N0         &kp MINUS
&kp TAB    &kp Q      &kp W     &kp F     &kp P      &kp B   &none                                                              &none        &kp J   &kp L   &kp U      &kp Y     &kp SEMICOLON  &kp BSLH
&kp ESC    &kp A      &kp R     &kp S     &kp T      &kp G   &bootloader  &rgb_ug_L3  &rgb_ug_L2      &kp RIGHT_ALT  &kp RCTRL  &none        &kp M   &kp N   &kp E      &kp I     &kp O          &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp D      &kp V                            &rgb_ug_L1      &kp HOME                               &kp K   &kp H   &kp COMMA  &kp DOT   &kp FSLH       &kp RSHFT
&none      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC     &kp DEL     &rgb_ug_L0      &kp END        &kp ENTER  &kp SPACE            &kp UP  &kp DOWN   &kp LBKT  &kp RBKT       &none
            >;
        };

        Nav {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3     &kp N4     &kp N5    &trans                                                         &bootloader  &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp LEFT   &kp DOWN  &kp UP     &kp RIGHT  &kp T     &none                                                          &none        &kp Y   &kp END     &kp PG_UP     &kp PAGE_DOWN  &kp DEL          &kp BSLH
&kp ESC    &kp LEFT   &kp DOWN  &kp UP     &kp RIGHT  &kp HOME  &bootloader  &rgb_ug_L3  &rgb_ug_L2      &kp LGUI   &kp RCTRL  &none        &kp H   &kp K_UNDO  &kp K_REDO    &kp K_COPY     &kp K_PASTE      &kp SQT
&kp LSHFT  &kp TAB    &kp ESC   &kp K_CUT  &kp V      &kp B                              &rgb_ug_L1      &kp PG_UP                          &kp N   &kp INS     &kp K_SELECT  &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&none      &kp GRAVE  &kp CAPS  &kp LEFT   &kp RIGHT            &kp BSPC     &kp DEL     &rgb_ug_L0      &kp PG_DN  &kp ENTER  &kp KP_N0            &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &none
            >;

            label = "Nav";
        };

        Sym {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1           &kp N2         &kp N3     &kp N4             &kp N5         &trans                                                      &none      &kp N6          &kp KP_NUM       &kp KP_EQUAL      &kp KP_DIVIDE         &kp KP_MULTIPLY        &kp MINUS
&kp TAB    &kp EXCLAMATION  &kp AT_SIGN    &kp HASH   &kp DOLLAR         &kp PERCENT    &none                                                       &none      &kp CARET       &kp AMPERSAND    &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BSLH
&kp ESC    &kp UNDERSCORE   &kp PLUS       &kp EQUAL  &kp MINUS          &kp TILDE      &none     &rgb_ug_L3  &rgb_ug_L2      &kp LGUI   &kp RCTRL  &none      &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp PIPE               &kp SQT
&kp LSHFT  &kp GRAVE        &kp BACKSLASH  &kp SQT    &kp DOUBLE_QUOTES  &kp SEMICOLON                        &rgb_ug_L1      &kp PG_UP                        &kp COLON       &kp LESS_THAN    &kp GREATER_THAN  &kp QUESTION          &kp SLASH              &kp RSHFT
&none      &kp GRAVE        &kp CAPS       &kp LEFT   &kp RIGHT                         &kp BSPC  &kp DEL     &rgb_ug_L0      &kp PG_DN  &kp ENTER  &kp KP_N0                  &kp UP           &kp DOWN          &kp KP_DOT            &kp RBKT               &none
            >;

            label = "Sym";
        };

        Num {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1        &kp N2        &kp N3        &kp N4        &kp N5  &trans                                                      &none      &kp N6        &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp LS(F1)    &kp F2        &kp F3        &kp F4        &kp F5  &none                                                       &none      &kp F6        &kp F7      &kp F8        &kp F9         &kp F10          &kp BSLH
&kp ESC    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5  &none     &rgb_ug_L3  &rgb_ug_L2      &kp LGUI   &kp RCTRL  &none      &kp NUMBER_6  &kp N7      &kp N8        &kp NUMBER_9   &kp NUMBER_0     &kp SQT
&kp LSHFT  &kp F11       &kp F12       &kp K_CUT     &kp V         &kp B                         &rgb_ug_L1      &kp PG_UP                        &kp N         &kp INS     &kp K_SELECT  &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&none      &kp GRAVE     &kp CAPS      &kp LEFT      &kp RIGHT             &kp BSPC  &kp DEL     &rgb_ug_L0      &kp PG_DN  &kp ENTER  &kp KP_N0                &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &none
            >;

            label = "Num";
        };
    };
};
